# Runtime: connects as ft_app (subject to row-level security)
DATABASE_URL=postgresql+psycopg://ft_app:ft_app_dev@localhost:5432/finance_tracker
# Migrations: connects as ft_owner
MIGRATION_DATABASE_URL=postgresql+psycopg://ft_owner:ft_owner_dev@localhost:5432/finance_tracker
ALLOW_REGISTRATION=true
# auto: Secure cookie only over HTTPS (true/false to force)
COOKIE_SECURE=auto
SESSION_DAYS=30
