# Copy to .env next to docker-compose.yml. Use long random values (e.g. `openssl rand -hex 24`).
# Nothing is required: the database is built in and its passwords are generated on first start (data/secrets.env).
DATA_DIR=/mnt/user/appdata/astris
PORT=8484
ALLOW_REGISTRATION=true
# Your email: that account becomes the server admin (otherwise the first account registered does)
ADMIN_EMAIL=
TZ=Europe/London
# Optional: encrypt backups (store this passphrase somewhere safe, it can't be recovered)
BACKUP_PASSPHRASE=
# Optional: local HTTPS so phones can scan barcodes with the live camera (P-6).
# self-signed = the server makes its own certificate; install http(s)://YOUR-SERVER:PORT/ca.crt on each phone once.
HTTPS=off
# The address(es) you open Astris with, comma-separated, e.g. 192.168.1.20,tower.local
TLS_HOSTNAMES=
# Optional: encrypt kept files, notification secrets and calendar links (P-10).
# Make one with `docker compose run --rm app python -m app.crypto new-key`. Keep a copy somewhere safe.
ASTRIS_KEY=
ASTRIS_OLD_KEYS=
# Only if you use your own PostgreSQL instead of the built-in one:
DB_HOST=
DB_ADMIN_URL=
DB_APP_PASSWORD=
DB_OWNER_PASSWORD=
